#!/usr/bin/env bash
# power — ipmitool chassis power with a confirm gate, a running-host check and a JSON Lines audit log.
# The logic is lib/power/power.php; `power --help` lists the actions, options and environment.
# Unset variables can come from the defaults file (lib/defaults.sh, README).
here="$(dirname "$(readlink -f "$0")")"
. "$here/lib/defaults.sh"
exec php "$here/lib/power/power.php" "$@"
