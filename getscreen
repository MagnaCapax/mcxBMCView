#!/usr/bin/env bash
# getscreen — capture a BMC console as an image: AMI MegaRAC HTML5 KVM, Supermicro ATEN console preview, or
# iDRAC6-era BMCs through idrac6. The logic is lib/getscreen/getscreen.php.
# Usage: getscreen [--wait MS] <bmc-host> [output.jpg]
# Env: BMC_PASS (required), BMC_USER or BMC_USER_CANDIDATES, BMC_RENDER_WAIT, IDRAC6_JAVA, BMC_DEBUG=1
# Unset variables can come from the defaults file (lib/defaults.sh, README).
here="$(dirname "$(readlink -f "$0")")"
. "$here/lib/defaults.sh"
exec php "$here/lib/getscreen/getscreen.php" "$@"
